# ================================================================
# CONFIGURAÇÃO DO FIREBASE (NUVEM)
# Obtenha estes valores no Console do Firebase:
# https://console.firebase.google.com/ -> Seu Projeto -> Configurações do Projeto (ícone de engrenagem) -> Seus Aplicativos (Web)
# ================================================================

VITE_FIREBASE_API_KEY=sua_chave_firebase_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ================================================================
# SERVIÇO BIOMÉTRICO LOCAL (C#)
# Endereço onde o executável C# (ConsoleApp1) está rodando com o leitor USB DigitalPersona
# Padrão: http://localhost:5000/
# ================================================================
VITE_CSHARP_SERVICE_URL=http://localhost:5000/

# ================================================================
# BACKEND LOCAL OPCIONAL (FastAPI)
# Caso deseje utilizar o backend Python local em vez do Firebase
# ================================================================
VITE_API_BASE=http://127.0.0.1:8083
